data/raw/
data/interim/
*.ckpt
wandb/
__pycache__/
.venv/

# --- MathScholar (A2) ---
# Large derived artifacts: recreated by scripts/get_data.sh + scripts/build_index.sh.
# Never commit these (~1 GB, images) — the handbook says commit only the held-out sample pages.
data/pages/
data/index/
data/eda_summary.json
data/corpus_version.json

# data/annot/ is split, not blanket-ignored:
#   nist/  -- Stage A crops (Step 25). MEASURED at 3.1 MB / 431 pairs (not the
#             thousands-of-images volume this comment used to warn might happen) --
#             small enough to commit outright, same call as data/ocr/ below, same
#             reason: Step 26 (S2) is a different owner who needs the real crops, not
#             just a manifest. See data/README.md "Step 25" for why the count is 431,
#             not the 5000-6000 target (a deliberate safety filter, not a shortfall).
#   test/  -- rendered scratch images (Step 18); redundant with the real output, which
#             already goes to the COMMITTED grading_kit/heldout_pages/ + labels.jsonl.
#   val/, train/ -- the actual hand-corrected JSON annotations (Steps 21-24). Same
#             reasoning as data/ocr/: small text, and needed by a DIFFERENT teammate's
#             LATER step (Step 27 datamodule.py, Step 28's actual fine-tune run) --
#             "commit only a manifest" would leave whoever runs Step 27/28 unable to
#             actually load 2/3 of the training set without an out-of-band file transfer.
data/annot/test/
!data/annot/nist/
!data/annot/nist/**
!data/annot/val/
!data/annot/val/**
!data/annot/train/
!data/annot/train/**

# ...but NOT the page images themselves. Step 18 puts a 300-dpi grayscale render of
# each annotation page beside its JSON (~0.84 MB each, ~105 MB across val+train) —
# the un-ignore rules above would otherwise track every one of them, re-committing a
# tenth of the corpus we were careful to keep out at Step 1. They are reproducible in
# one command (`ANNOT=1 bash scripts/get_data.sh`) and byte-identical to data/pages/.
data/annot/val/*.png
data/annot/train/*.png

# data/ocr/ is NOT in the same category as data/pages/ above: it's our own derived text
# (OCR transcripts + sidecars), not "the corpus" itself, and it is tiny even at full-book
# coverage (measured: 2.4 MB for 594 pages at Step 16; ~1-2.5 MB projected for all 1046
# after Step 30's fine-tuned re-OCR) -- nothing like data/pages/'s ~1 GB of page images.
# kb_demo.ipynb reads it directly to reproduce the char-F1/exact-match numbers quoted in
# the form, so a clean clone needs it present for the grounding gate to be re-checkable,
# not just readable from a saved cell. Committed for the same reason the LoRA adapter is.
#
# ...and the LoRA adapter IS a submitted artifact (needed to reproduce our numbers),
# so un-ignore both.
!data/ocr/
!data/ocr/**
!data/models/
!data/models/**

# Secrets — never commit
.env

# Local tooling noise
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
