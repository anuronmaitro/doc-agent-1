!s\\!\\left( a,\\,x\\right)\\!\\right.\\)\n\n**19.21.2**\n\n\\(W\\!\\left(a,\\,x\\right)\\!=\\!\\sqrt{2k/\\!x}\\!\\left\\{\\,s_{1}\\!\\left(a,\\,x\\right)\\cos \\left(\\!\\{x^{2}\\!-\\!a\\ln\\,x\\!+\\!\\frac{1}{4}\\pi\\!+\\!\\frac{1}{2}\\phi_{2}\\!\\right) \\!\\right.\\)\n\n\\(\\left.-\\,s_{2}\\!\\left(a,\\,x\\right)\\sin\\left(\\!\\{x^{2}\\!-\\!a\\ln\\,x\\!+\\!\\frac{1} {4}\\pi\\!+\\!\\frac{1}{2}\\phi_{2}\\!\\right)\\!\\right\\}\\)\n\n**19.21.3**\n\n\\(W\\!\\left(a,\\!\\!-\\!\\!x\\right)\\!=\\!\\sqrt{2/\\!kx}\\!\\left\\{\\,s_{1}\\!\\left(a,\\,x \\right)\\sin\\left(\\!\\{x^{2}\\!-\\!a\\ln\\,x\\!+\\!\\frac{1}{4}\\pi\\!+\\!\\frac{1}{2}\\phi_ {2}\\!\\right)\\!\\right.\\)\n\n\\(\\left.+\\,s_{2}\\!\\left(a,\\,x\\right)\\cos\\left(\\!\\{x^{2}\\!-\\!a\\ln\\,x\\!+\\!\\frac{1} {4}\\pi\\!+\\!\\frac{1}{2}\\phi_{2}\\!\\right)\\!\\right\\}\\)\n\nwhere \\(\\phi_{2}\\) is defined by **19.17.10**\n\n**19.21.4**: \\(s\\!\\left(a,\\,x\\right)\\!=\\!s_{1}\\!\\left(a,\\,x\\right)\\!+\\!is_{2}\\!\\left(a,\\,x\\right)\\)\n\n**19.21.5**: \\(s_{1}\\!\\left(a,\\,x\\right)\\!\\sim\\!1\\!+\\!\\frac{v_{2}}{1!2x^{2}}\\!\\frac{u_{4}}{2! 2^{2}x^{4}}\\!\\frac{v_{6}}{3!2^{3}x^{6}}\\!+\\!\\frac{u_{8}}{4!2^{3}x^{+}}\\!+\\,\\ldots\\)\n**19.21.6**: \\(s_{2}\\!\\left(a,\\,x\\right)\\!\\sim\\!-\\!\\frac{u_{2}}{1!2x^{2}}\\!\\frac{v_{4}}{2!2^{2} x^{4}}\\!+\\!\\frac{u_{6}}{3!2^{3}x^{6}}\\!+\\!\\frac{v_{8}}{4!2^{3}x^{6}}\\!-\\,\\ldots\\)\n\nwith\n\n\\begin{table}\n\\begin{tabular}{|c|} \\hline \\(19.20.1\\) \\\\ \\(\\tau\\!=\\!-\\!(\\frac{3}{2}\\delta_{3})^{\\ddagger}\\) \\\\ \\(\\vartheta_{3}\\!=\\!\\frac{1}{2}\\int_{t}^{t}\\!\\sqrt{1\\!-\\!s^{2}}\\,d\\!s\\!=\\!\\frac{1}{4}\\,\\arccos\\,\\xi\\!-\\!\\frac{1}{4}\\xi\\,\\sqrt{1\\!-\\!\\xi^{2}}\\quad(\\xi\\!\\leq\\!1)\\) \\\\ \\(\\tau\\!=\\!+\\!(\\frac{3}{2}\\vartheta_{2})^{\\ddagger}\\) \\\\ \\(\\vartheta_{2}\\!=\\!\\frac{1}{2}\\!\\int_{1}^{t}\\!\\sqrt{s^{2}\\!-\\!1}d\\!s\\!=\\!\\frac{1}{4}\\xi\\,\\sqrt{\\xi^{2}\\!-\\!1}\\!-\\!\\frac{1}{4}\\,\\arccos\\,\\xi\\q