**9.1.15**

\[\begin{array}{l}{\cal W}\left\{J_{v}(z),J_{-v}(z)\right\}=&J_{v+1}(z)J_{-v}(z) +_{-v}J_{v}(z)J_{-(p+1)}(z)\\ =&-2\mbox{ sin }(v\pi)/(\pi z)\\ \\ \end{array}\]

**9.1.16**

\[\begin{array}{l}{\cal W}\left\{J_{v}(z),\vec{Y}_{v}(z)\right\}=&J_{v+1}(z) \vec{Y}_{v}(z)-J_{v}(z)\vec{Y}_{v+1}(z)\\ \\ =&2/(\pi z)\\ \end{array}\]

**9.1.17**

\[\begin{array}{l}{\cal W}\left\{H^{(1)}_{v}(z),\ H^{(2)}_{v}(z)\right\}=&H^{(1 )}_{v+1}(z)H^{(2)}_{v}(z)-H^{(1)}_{v}(z)H^{(2)}_{v+1}(z)\\ \\ =&-4\dot{i}/(\pi z)\\ \end{array}\]

