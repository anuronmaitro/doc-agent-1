\[\begin{array}{c} {\int_{a}^{s}B_{n}(t)dt} = \frac{B_{n + 1}(x) - B_{n + 1}(a)}{n + 1} \\ {\int_{0}^{1}B_{n}(t)B_{n}(t)dt} = (-1)^{n - 1}\frac{m!n!}{(m + n)!}B_{m + n} \\ {\int_{0}^{1}E_{n}(t)E_{m}(t)dt} \\ {\hskip 14.226378pt}m,n = 1,2,\ldots \\ \end{array}\]

\[\begin{array}{c} {\int_{a}^{s}E_{n}(t)dt} = \frac{E_{s + 1}(x) - E_{s + 1}(a)}{n + 1} \\ {\int_{0}^{1}E_{n}(t)E_{m}(t)dt} \\ {\hskip 14.226378pt}= (-1)^{n}4(2^{n + n + 2} - 1)\frac{m!n!}{(m + n + 2)!}B_{n + n + 2} \\ {\hskip 14.226378pt}m,n = 0,1,\ldots \\ \end{array}\]

(The polynomials are orthogonal for \(m + n\) odd.)

